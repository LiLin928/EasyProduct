<!-- 商品搜索页 -->
<view class="search-page">
  <!-- 搜索栏 -->
  <view class="search-header">
    <view class="search-input-wrap">
      <image class="search-icon" src="/static/icons/search.png" />
      <input 
        class="search-input" 
        placeholder="{{ t('common.search.placeholder') }}"
        value="{{ keyword }}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="clear-btn" wx:if="{{ keyword }}" bindtap="onClear">
        <text>×</text>
      </view>
    </view>
    <view class="search-btn" bindtap="onSearch">
      <text>搜索</text>
    </view>
  </view>

  <!-- 搜索历史和热门 -->
  <view class="search-suggestions" wx:if="{{ products.length === 0 }}">
    <!-- 搜索历史 -->
    <view class="suggestion-section" wx:if="{{ history.length > 0 }}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <view class="clear-history" bindtap="onClearHistory">
          <image class="delete-icon" src="/static/icons/delete.png" />
          <text>清空</text>
        </view>
      </view>
      <view class="keyword-list">
        <view 
          class="keyword-item" 
          wx:for="{{ history }}" 
          wx:key="*this"
          data-keyword="{{ item }}"
          bindtap="onKeywordTap"
        >
          <text>{{ item }}</text>
        </view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="suggestion-section">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="keyword-list">
        <view 
          class="keyword-item hot" 
          wx:for="{{ hotKeywords }}" 
          wx:key="*this"
          data-keyword="{{ item }}"
          bindtap="onKeywordTap"
        >
          <text>{{ item }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <scroll-view 
    class="search-results" 
    scroll-y 
    wx:if="{{ products.length > 0 }}"
    bindscrolltolower="onLoadMore"
  >
    <view class="product-grid">
      <view 
        class="product-item" 
        wx:for="{{ products }}" 
        wx:key="id"
        data-id="{{ item.id }}"
        bindtap="onProductTap"
      >
        <image class="product-image" src="{{ item.image || '/static/images/placeholder.jpg' }}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{ item.name }}</text>
          <view class="product-price-row">
            <text class="product-price">¥{{ item.price }}</text>
            <text class="product-sales" wx:if="{{ item.sales }}">已售{{ item.sales }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{ loading }}">
      <text>{{ t("common.loading") }}</text>
    </view>
    <view class="no-more" wx:if="{{ !hasMore && products.length > 0 }}">
      <text>没有更多商品了</text>
    </view>
  </scroll-view>

  <!-- 空结果 -->
  <view class="empty-result" wx:if="{{ products.length === 0 && keyword && !loading }}">
    <image class="empty-icon" src="/static/icons/search-empty.png" mode="aspectFit" />
    <text class="empty-text">没有找到相关商品</text>
    <view class="go-home-btn" bindtap="onGoHome">去首页看看</view>
  </view>
</view>
