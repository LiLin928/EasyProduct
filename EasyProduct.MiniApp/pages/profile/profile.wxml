<!-- 个人中心页 -->
<view class="profile-page">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-info" wx:if="{{ isLoggedIn && member }}">
      <image class="user-avatar" src="{{ member.avatarUrl || '/static/icons/default-avatar.png' }}" mode="aspectFill" />
      <view class="user-meta">
        <text class="user-name">{{ member.nickname || '用户' + member.id.slice(-6) }}</text>
        <text class="user-phone" wx:if="{{ member.phone }}">{{ member.phone }}</text>
      </view>
    </view>
    <view class="user-info not-login" wx:if="{{ !isLoggedIn }}" bindtap="onLogin">
      <image class="user-avatar" src="/static/icons/default-avatar.png" mode="aspectFill" />
      <view class="user-meta">
        <text class="user-name">点击登录</text>
        <text class="user-tip">登录后享受更多服务</text>
      </view>
      <image class="arrow-icon" src="/static/icons/arrow-right.png" />
    </view>
  </view>

  <!-- 订单快捷入口 -->
  <view class="order-section">
    <view class="section-header" bindtap="onViewOrders" data-status="">
      <text class="section-title">我的订单</text>
      <view class="section-more">
        <text>查看全部</text>
        <image class="arrow-icon" src="/static/icons/arrow-right.png" />
      </view>
    </view>
    <view class="order-types">
      <view class="type-item" bindtap="onViewOrders" data-status="pending">
        <view class="type-icon">
          <image src="/static/icons/order-pending.png" />
          <view class="badge" wx:if="{{ orderStats.pending > 0 }}">{{ orderStats.pending }}</view>
        </view>
        <text class="type-name">待付款</text>
      </view>
      <view class="type-item" bindtap="onViewOrders" data-status="paid">
        <view class="type-icon">
          <image src="/static/icons/order-paid.png" />
          <view class="badge" wx:if="{{ orderStats.paid > 0 }}">{{ orderStats.paid }}</view>
        </view>
        <text class="type-name">待发货</text>
      </view>
      <view class="type-item" bindtap="onViewOrders" data-status="shipped">
        <view class="type-icon">
          <image src="/static/icons/order-shipped.png" />
          <view class="badge" wx:if="{{ orderStats.shipped > 0 }}">{{ orderStats.shipped }}</view>
        </view>
        <text class="type-name">待收货</text>
      </view>
      <view class="type-item" bindtap="onViewOrders" data-status="completed">
        <view class="type-icon">
          <image src="/static/icons/order-completed.png" />
        </view>
        <text class="type-name">已完成</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onAddress">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/address.png" />
        <text class="menu-name">收货地址</text>
      </view>
      <image class="arrow-icon" src="/static/icons/arrow-right.png" />
    </view>
    <view class="menu-item" bindtap="onContactService">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/service.png" />
        <text class="menu-name">联系客服</text>
      </view>
      <image class="arrow-icon" src="/static/icons/arrow-right.png" />
    </view>
    <view class="menu-item" bindtap="onSettings">
      <view class="menu-left">
        <image class="menu-icon" src="/static/icons/settings.png" />
        <text class="menu-name">设置</text>
      </view>
      <image class="arrow-icon" src="/static/icons/arrow-right.png" />
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{ isLoggedIn }}">
    <view class="logout-btn" bindtap="onLogout">
      <text>退出登录</text>
    </view>
  </view>
</view>
