/* pages/login/login.wxss */

page {
  background-color: #f6f8fa;
}

.login-page {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #333;
  margin-right: 8rpx;
}

.back-text {
  font-size: 32rpx;
  color: #333;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.app-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999;
}

/* 登录表单 */
.login-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f6f8fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
}

.prefix {
  font-size: 30rpx;
  color: #666;
  margin-right: 20rpx;
  font-weight: 500;
}

.input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 96rpx;
  line-height: 96rpx;
}

.password-input {
  padding-right: 20rpx;
}

.clear-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
}

.clear-icon {
  font-size: 28rpx;
  color: #fff;
}

/* 错误提示 */
.error-msg {
  background: #fff2f0;
  color: #ff4d4f;
  font-size: 26rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  border-left: 6rpx solid #ff4d4f;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-bottom: 24rpx;
}

.login-btn::after {
  border: none;
}

.phone-btn {
  background: linear-gradient(135deg, #1e6fff 0%, #0d5de0 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(30, 111, 255, 0.3);
}

.phone-btn:active {
  background: linear-gradient(135deg, #0d5de0 0%, #0a4bc0 100%);
}

.phone-btn.loading {
  opacity: 0.7;
}

.wx-btn {
  background: #07c160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.wx-btn:active {
  background: #06ad56;
}

.wx-btn.loading {
  opacity: 0.7;
}

.wx-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e8e8e8;
}

.divider-text {
  font-size: 26rpx;
  color: #999;
  padding: 0 24rpx;
}

/* 底部链接 */
.bottom-links {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 60rpx;
}

.link {
  font-size: 28rpx;
  color: #1e6fff;
}

.separator {
  font-size: 28rpx;
  color: #ccc;
  margin: 0 24rpx;
}

/* 用户协议 */
.terms-section {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 20rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #1e6fff;
  border-color: #1e6fff;
}

.checkbox text {
  color: #fff;
  font-size: 24rpx;
}

.terms-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.terms-link {
  color: #1e6fff;
}
