<view class="login-page">
  <!-- 返回按钮 -->
  <view class="nav-bar" bindtap="onBack">
    <text class="back-icon">‹</text>
    <text class="back-text">返回</text>
  </view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <image class="logo" src="https://via.placeholder.com/160x160/1e6fff/ffffff?text=EP" mode="aspectFit" />
    <text class="app-name">EasyProduct</text>
    <text class="app-slogan">便捷购物，品质生活</text>
  </view>

  <!-- 登录表单 -->
  <view class="login-form">
    <!-- 手机号输入 -->
    <view class="input-group">
      <text class="input-label">手机号</text>
      <view class="input-wrapper">
        <text class="prefix">+86</text>
        <input 
          class="input" 
          type="number" 
          maxlength="11" 
          placeholder="请输入手机号" 
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
        <view wx:if="{{phone}}" class="clear-btn" bindtap="clearPhone">
          <text class="clear-icon">×</text>
        </view>
      </view>
    </view>

    <!-- 密码输入 -->
    <view class="input-group">
      <text class="input-label">密码</text>
      <view class="input-wrapper">
        <input 
          class="input password-input" 
          type="password" 
          placeholder="请输入密码" 
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <view wx:if="{{password}}" class="clear-btn" bindtap="clearPassword">
          <text class="clear-icon">×</text>
        </view>
      </view>
    </view>

    <!-- 错误提示 -->
    <view wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</view>

    <!-- 手机号登录按钮 -->
    <button 
      class="login-btn phone-btn {{loading ? 'loading' : ''}}" 
      bindtap="onPhoneLogin"
      disabled="{{loading}}"
    >
      <text wx:if="{{!loading}}">手机号登录</text>
      <text wx:else>登录中...</text>
    </button>

    <!-- 分割线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <!-- 微信一键登录 -->
    <button 
      class="login-btn wx-btn {{loading ? 'loading' : ''}}" 
      bindtap="onWxLogin"
      disabled="{{loading}}"
    >
      <text class="wx-icon">WeChat</text>
      <text>微信一键登录</text>
    </button>
  </view>

  <!-- 底部链接 -->
  <view class="bottom-links">
    <text class="link" bindtap="goToRegister">注册账号</text>
    <text class="separator">|</text>
    <text class="link" bindtap="goToForgot">忘记密码</text>
  </view>

  <!-- 用户协议 -->
  <view class="terms-section">
    <view class="checkbox {{agreeTerms ? 'checked' : ''}}" bindtap="toggleTerms">
      <text wx:if="{{agreeTerms}}">✓</text>
    </view>
    <view class="terms-text">
      <text>我已阅读并同意</text>
      <text class="terms-link" bindtap="onViewTerms">《用户协议》</text>
      <text>和</text>
      <text class="terms-link" bindtap="onViewPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>

