{
  "IsDevelopment": false,
  "IsUseSwagger": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=easyproduct;Uid=root;Pwd=;Charset=utf8mb4;SslMode=None;"
  },
  "JWTTokenOptions": {
    "SecretKey": "your-secret-key-min-32-chars-long-here!!!",
    "Issuer": "EasyProduct",
    "Audience": "EasyProduct",
    "ExpiresInMinutes": 1440
  },
  "WxPay": {
    "Enabled": false,
    "AppId": "wx1234567890abcdef",
    "MchId": "",
    "ApiKey": "",
    "CertSerialNo": "",
    "CertPath": "certs/apiclient_key.pem",
    "NotifyUrl": "https://api.example.com/api/app/payment/callback",
    "ExpireMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}