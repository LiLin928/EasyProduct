## 5. Service 层实现指南

### 5.1 商品分类服务

```csharp
using EasyProduct.Common.Base;
using EasyProduct.Common.Error;
using EasyProduct.Models.Dto.Product;
using EasyProduct.Models.Entitys.Product;
using Mapster;
using SqlSugar;

namespace EasyProduct.Business.Product;

/// <summary>
/// 商品分类服务接口
/// </summary>
public interface IProductCategoryService
{
    /// <summary>
    /// 获取分类树
    /// </summary>
    Task<List<CategoryDto>> GetTreeAsync();

    /// <summary>
    /// 创建分类
    /// </summary>
    Task<bool> CreateAsync(CreateCategoryDto dto);

    /// <summary>
    /// 更新分类
    /// </summary>
    Task<bool> UpdateAsync(UpdateCategoryDto dto);

    /// <summary>
    /// 删除分类
    /// </summary>
    Task<bool> DeleteAsync(Guid id);
}

/// <summary>
/// 商品分类服务实现
/// </summary>
public class ProductCategoryService : BaseService<product_category>, IProductCategoryService
{
    /// <summary>
    /// 获取分类树
    /// </summary>
    /// <returns>分类树列表</returns>
    /// <remarks>
    /// 1. 查询所有未删除的分类
    /// 2. 构建树形结构
    /// 3. 按排序号排序
    /// </remarks>
    public async Task<List<CategoryDto>> GetTreeAsync()
    {
        // 查询所有分类
        var categories = await GetListAsync(c => !c.IsDeleted);

        // 映射为 DTO
        var dtoList = categories.Adapt<List<CategoryDto>>();

        // 构建树形结构
        return BuildTree(dtoList, null);
    }

    /// <summary>
    /// 创建分类
    /// </summary>
    /// <param name="dto">创建参数</param>
    /// <returns>创建成功返回 true</returns>
    /// <exception cref="BusinessException">编码已存在时抛出</exception>
    public async Task<bool> CreateAsync(CreateCategoryDto dto)
    {
        // 检查编码是否已存在
        if (await ExistsAsync(c => c.Code == dto.Code && c.IsDeleted == DeleteStatus.NotDeleted))
        {
            throw new BusinessException("分类编码已存在", 400);
        }

        // 检查父分类是否存在
        if (dto.ParentId.HasValue)
        {
            var parent = await GetByIdAsync(dto.ParentId.Value);
            if (parent == null || parent.IsDeleted == DeleteStatus.Deleted)
            {
                throw new BusinessException("父分类不存在", 404);
            }
        }

        var entity = dto.Adapt<product_category>();
        entity.Id = Guid.NewGuid();
        entity.Status = CommonStatus.Enabled;
        entity.IsDeleted = DeleteStatus.NotDeleted;
        entity.CreatedAt = DateTime.UtcNow;
        entity.UpdatedAt = null;

        return await InsertAsync(entity);
    }

    /// <summary>
    /// 更新分类
    /// </summary>
    /// <param name="dto">更新参数</param>
    /// <returns>更新成功返回 true</returns>
    /// <exception cref="BusinessException">分类不存在或编码重复时抛出</exception>
    public async Task<bool> UpdateAsync(UpdateCategoryDto dto)
    {
        var entity = await GetByIdAsync(dto.Id);
        if (entity == null || entity.IsDeleted == DeleteStatus.Deleted)
        {
            throw new BusinessException("分类不存在", 404);
        }

        // 检查编码唯一性
        if (!string.IsNullOrEmpty(dto.Code) && dto.Code != entity.Code)
        {
            if (await ExistsAsync(c => c.Code == dto.Code && c.Id != dto.Id && c.IsDeleted == DeleteStatus.NotDeleted))
            {
                throw new BusinessException("分类编码已存在", 400);
            }
        }

        // 更新字段
        if (!string.IsNullOrEmpty(dto.Name))
            entity.Name = dto.Name;
        if (!string.IsNullOrEmpty(dto.NameEn))
            entity.NameEn = dto.NameEn;
        if (dto.ParentId.HasValue)
            entity.ParentId = dto.ParentId;
        if (!string.IsNullOrEmpty(dto.Code))
            entity.Code = dto.Code;
        if (dto.Sort.HasValue)
            entity.Sort = dto.Sort.Value;
        if (dto.Status.HasValue)
            entity.Status = dto.Status.Value;

        entity.UpdatedAt = DateTime.UtcNow;

        return await UpdateAsync(entity) > 0;
    }

    /// <summary>
    /// 删除分类（软删除）
    /// </summary>
    /// <param name="id">分类ID</param>
    /// <returns>删除成功返回 true</returns>
    /// <exception cref="BusinessException">分类不存在或存在子分类时抛出</exception>
    public async Task<bool> DeleteAsync(Guid id)
    {
        var entity = await GetByIdAsync(id);
        if (entity == null || entity.IsDeleted == DeleteStatus.Deleted)
        {
            throw new BusinessException("分类不存在", 404);
        }

        // 检查是否存在子分类
        if (await ExistsAsync(c => c.ParentId == id && c.IsDeleted == DeleteStatus.NotDeleted))
        {
            throw new BusinessException("存在子分类，无法删除", 400);
        }

        // 检查是否存在商品
        if (await _db.Queryable<product_spu>().AnyAsync(s => s.CategoryId == id && s.IsDeleted == DeleteStatus.NotDeleted))
        {
            throw new BusinessException("分类下存在商品，无法删除", 400);
        }

        entity.IsDeleted = DeleteStatus.Deleted;
        entity.UpdatedAt = DateTime.UtcNow;
        entity.Status = CommonStatus.Disabled;

        return await UpdateAsync(entity) > 0;
    }

    /// <summary>
    /// 构建树形结构
    /// </summary>
    private List<CategoryDto> BuildTree(List<CategoryDto> all, Guid? parentId)
    {
        return all
            .Where(c => c.ParentId == parentId)
            .OrderBy(c => c.Sort)
            .Select(c =>
            {
                c.Children = BuildTree(all, c.Id);
                return c;
            })
            .ToList();
    }
}
```

### 5.2 商品SPU服务

```csharp
using EasyProduct.Common.Base;
using EasyProduct.Common.Error;
using EasyProduct.Models.Dto.Product;
using EasyProduct.Models.Entitys.Product;
using Mapster;
using SqlSugar;
using System.Text.Json;

namespace EasyProduct.Business.Product;

/// <summary>
/// 商品SPU服务接口
/// </summary>
public interface IProductSpuService
{
    /// <summary>
    /// 分页查询SPU列表
    /// </summary>
    Task<PageResponse<SpuDto>> GetPageListAsync(SpuQueryDto query);

    /// <summary>
    /// 获取SPU详情（含SKU）
    /// </summary>
    Task<SpuDto?> GetByIdAsync(Guid id);

    /// <summary>
    /// 创建SPU（自动生成SKU）
    /// </summary>
    Task<bool> CreateAsync(CreateSpuDto dto);

    /// <summary>
    /// 更新SPU
    /// </summary>
    Task<bool> UpdateAsync(UpdateSpuDto dto);

    /// <summary>
    /// 删除SPU
    /// </summary>
    Task<bool> DeleteAsync(Guid id);
}

/// <summary>
/// 商品SPU服务实现
/// </summary>
public class ProductSpuService : BaseService<product_spu>, IProductSpuService
{
    /// <summary>
    /// 分页查询SPU列表
    /// </summary>
    /// <param name="query">查询参数</param>
    /// <returns>SPU分页列表</returns>
    /// <remarks>
    /// 支持按分类、类型、状态、关键词筛选
    /// </remarks>
    public async Task<PageResponse<SpuDto>> GetPageListAsync(SpuQueryDto query)
    {
        var whereExpr = Expressionable.Create<product_spu>()
            .AndIF(!string.IsNullOrEmpty(query.Keyword),
                s => s.Name.Contains(query.Keyword!) || s.Code.Contains(query.Keyword!))
            .AndIF(query.CategoryId.HasValue, s => s.CategoryId == query.CategoryId!.Value)
            .AndIF(query.Type.HasValue, s => s.Type == query.Type.Value)
            .AndIF(query.Status.HasValue, s => s.Status == query.Status.Value)
            .And(s => s.IsDeleted == DeleteStatus.NotDeleted)
            .ToExpression();

        var result = await GetPageListAsync(
            query.PageIndex,
            query.PageSize,
            whereExpr,
            s => s.CreatedAt,
            isAsc: false);

        // 映射为 DTO
        var dtoList = result.List.Select(s =>
        {
            var dto = s.Adapt<SpuDto>();
            // 解析图片和规格
            if (!string.IsNullOrEmpty(s.Images))
                dto.Images = JsonSerializer.Deserialize<List<string>>(s.Images);
            if (!string.IsNullOrEmpty(s.Specs))
                dto.Specs = JsonSerializer.Deserialize<List<SpecGroupDto>>(s.Specs);
            return dto;
        }).ToList();

        return PageResponse<SpuDto>.Create(dtoList, result.Total, result.PageIndex, result.PageSize);
    }

    /// <summary>
    /// 获取SPU详情（含SKU）
    /// </summary>
    /// <param name="id">SPU ID</param>
    /// <returns>SPU详情</returns>
    public async Task<SpuDto?> GetByIdAsync(Guid id)
    {
        var entity = await GetByIdAsync(id);
        if (entity == null || entity.IsDeleted == DeleteStatus.Deleted)
            return null;

        var dto = entity.Adapt<SpuDto>();

        // 解析图片和规格
        if (!string.IsNullOrEmpty(entity.Images))
            dto.Images = JsonSerializer.Deserialize<List<string>>(entity.Images);
        if (!string.IsNullOrEmpty(entity.Specs))
            dto.Specs = JsonSerializer.Deserialize<List<SpecGroupDto>>(entity.Specs);

        // 查询关联的 SKU
        var skus = await _db.Queryable<product_sku>()
            .Where(s => s.SpuId == id && s.IsDeleted == DeleteStatus.NotDeleted)
            .ToListAsync();

        dto.Skus = skus.Select(s =>
        {
            var skuDto = s.Adapt<SkuDto>();
            if (!string.IsNullOrEmpty(s.SpecValues))
                skuDto.SpecValues = JsonSerializer.Deserialize<Dictionary<string, string>>(s.SpecValues);
            return skuDto;
        }).ToList();

        return dto;
    }

    /// <summary>
    /// 创建SPU（自动生成SKU）
    /// </summary>
    /// <param name="dto">创建参数</param>
    /// <returns>创建成功返回 true</returns>
    /// <exception cref="BusinessException">编码重复或分类不存在时抛出</exception>
    public async Task<bool> CreateAsync(CreateSpuDto dto)
    {
        // 检查编码唯一性
        if (await ExistsAsync(s => s.Code == dto.Code && !s.IsDeleted))
        {
            throw new BusinessException("商品编码已存在", 400);
        }

        // 检查分类是否存在
        var category = await _db.Queryable<product_category>()
            .FirstAsync(c => c.Id == dto.CategoryId && !c.IsDeleted);
        if (category == null)
        {
            throw new BusinessException("商品分类不存在", 404);
        }

        var entity = dto.Adapt<product_spu>();
        entity.Id = Guid.NewGuid();
        entity.Images = dto.Images != null ? JsonSerializer.Serialize(dto.Images) : null;
        entity.Specs = dto.Specs != null ? JsonSerializer.Serialize(dto.Specs) : null;
        entity.Status = "inactive";
        entity.CreateTime = DateTime.Now;
        entity.UpdateTime = DateTime.Now;

        // 使用事务保存 SPU 和 SKU
        return await ExecuteTransactionAsync(async () =>
        {
            // 保存 SPU
            await InsertAsync(entity);

            // 自动生成 SKU
            if (dto.Specs != null && dto.Specs.Count > 0)
            {
                var skus = GenerateSkus(entity.Id, dto.Specs);
                foreach (var sku in skus)
                {
                    await _db.Insertable(sku).ExecuteCommandAsync();
                }
            }
            else if (dto.Skus != null && dto.Skus.Count > 0)
            {
                // 使用提供的 SKU 列表
                foreach (var skuDto in dto.Skus)
                {
                    var sku = skuDto.Adapt<product_sku>();
                    sku.Id = Guid.NewGuid();
                    sku.SpuId = entity.Id;
                    sku.Status = "active";
                    sku.CreateTime = DateTime.Now;
                    sku.UpdateTime = DateTime.Now;
                    sku.SpecValues = skuDto.SpecValues != null
                        ? JsonSerializer.Serialize(skuDto.SpecValues)
                        : null;
                    await _db.Insertable(sku).ExecuteCommandAsync();
                }
            }
        });
    }

    /// <summary>
    /// 更新SPU
    /// </summary>
    /// <param name="dto">更新参数</param>
    /// <returns>更新成功返回 true</returns>
    public async Task<bool> UpdateAsync(UpdateSpuDto dto)
    {
        var entity = await GetByIdAsync(dto.Id);
        if (entity == null || entity.IsDeleted)
        {
            throw new BusinessException("商品不存在", 404);
        }

        // 更新字段
        if (!string.IsNullOrEmpty(dto.Name))
            entity.Name = dto.Name;
        if (!string.IsNullOrEmpty(dto.NameEn))
            entity.NameEn = dto.NameEn;
        if (dto.CategoryId.HasValue)
            entity.CategoryId = dto.CategoryId.Value;
        if (!string.IsNullOrEmpty(dto.MainImage))
            entity.MainImage = dto.MainImage;
        if (dto.Images != null)
            entity.Images = JsonSerializer.Serialize(dto.Images);
        if (dto.Description != null)
            entity.Description = dto.Description;
        if (!string.IsNullOrEmpty(dto.Unit))
            entity.Unit = dto.Unit;
        if (dto.Brand != null)
            entity.Brand = dto.Brand;
        if (!string.IsNullOrEmpty(dto.Status))
            entity.Status = dto.Status;

        entity.UpdateTime = DateTime.Now;

        return await UpdateAsync(entity) > 0;
    }

    /// <summary>
    /// 删除SPU（软删除）
    /// </summary>
    /// <param name="id">SPU ID</param>
    /// <returns>删除成功返回 true</returns>
    public async Task<bool> DeleteAsync(Guid id)
    {
        var entity = await GetByIdAsync(id);
        if (entity == null || entity.IsDeleted)
            return false;

        // 检查是否存在订单关联（待实现订单模块后添加）

        entity.IsDeleted = true;
        entity.UpdateTime = DateTime.Now;
        entity.Status = "inactive";

        // 同时软删除关联的 SKU
        await _db.Updateable<product_sku>()
            .SetColumns(s => new product_sku { IsDeleted = true, UpdateTime = DateTime.Now, Status = "inactive" })
            .Where(s => s.SpuId == id)
            .ExecuteCommandAsync();

        return await UpdateAsync(entity) > 0;
    }

    /// <summary>
    /// 生成SKU列表（根据规格组合）
    /// </summary>
    private List<product_sku> GenerateSkus(Guid spuId, List<SpecGroupDto> specs)
    {
        var skus = new List<product_sku>();

        // 生成规格组合
        var combinations = GenerateCombinations(specs);

        foreach (var combo in combinations)
        {
            var sku = new product_sku
            {
                Id = Guid.NewGuid(),
                SpuId = spuId,
                SpecValues = JsonSerializer.Serialize(combo),
                Status = "active",
                CreateTime = DateTime.Now,
                UpdateTime = DateTime.Now
            };
            skus.Add(sku);
        }

        return skus;
    }

    /// <summary>
    /// 生成规格组合
    /// </summary>
    private List<Dictionary<string, string>> GenerateCombinations(List<SpecGroupDto> specs)
    {
        var result = new List<Dictionary<string, string>>();

        if (specs.Count == 0)
            return result;

        // 递归生成所有组合
        GenerateCombinationsRecursive(specs, 0, new Dictionary<string, string>(), result);

        return result;
    }

    /// <summary>
    /// 递归生成规格组合
    /// </summary>
    private void GenerateCombinationsRecursive(
        List<SpecGroupDto> specs,
        int index,
        Dictionary<string, string> current,
        List<Dictionary<string, string>> result)
    {
        if (index >= specs.Count)
        {
            result.Add(new Dictionary<string, string>(current));
            return;
        }

        var spec = specs[index];
        foreach (var value in spec.Values)
        {
            current[spec.Name] = value;
            GenerateCombinationsRecursive(specs, index + 1, current, result);
            current.Remove(spec.Name);
        }
    }
}
```

### 5.3 商品SKU服务

```csharp
using EasyProduct.Common.Base;
using EasyProduct.Common.Error;
using EasyProduct.Models.Dto.Product;
using EasyProduct.Models.Entitys.Product;
using Mapster;
using SqlSugar;
using System.Text.Json;

namespace EasyProduct.Business.Product;

/// <summary>
/// 商品SKU服务接口
/// </summary>
public interface IProductSkuService
{
    /// <summary>
    /// 更新单个SKU
    /// </summary>
    Task<bool> UpdateAsync(UpdateSkuDto dto);

    /// <summary>
    /// 批量更新SKU
    /// </summary>
    Task<bool> BatchUpdateAsync(BatchUpdateSkuDto dto);

    /// <summary>
    /// 扣减库存
    /// </summary>
    Task<bool> DeductStockAsync(Guid skuId, int quantity);

    /// <summary>
    /// 增加库存
    /// </summary>
    Task<bool> AddStockAsync(Guid skuId, int quantity);
}

/// <summary>
/// 商品SKU服务实现
/// </summary>
public class ProductSkuService : BaseService<product_sku>, IProductSkuService
{
    /// <summary>
    /// 更新单个SKU
    /// </summary>
    /// <param name="dto">更新参数</param>
    /// <returns>更新成功返回 true</returns>
    public async Task<bool> UpdateAsync(UpdateSkuDto dto)
    {
        var entity = await GetByIdAsync(dto.Id);
        if (entity == null || entity.IsDeleted)
        {
            throw new BusinessException("SKU不存在", 404);
        }

        // 更新字段
        if (!string.IsNullOrEmpty(dto.Barcode))
            entity.Barcode = dto.Barcode;
        if (dto.RetailPrice.HasValue)
            entity.RetailPrice = dto.RetailPrice.Value;
        if (dto.MemberPrice.HasValue)
            entity.MemberPrice = dto.MemberPrice.Value;
        if (dto.B2bPrice.HasValue)
            entity.B2bPrice = dto.B2bPrice;
        if (dto.CostPrice.HasValue)
            entity.CostPrice = dto.CostPrice.Value;
        if (dto.Stock.HasValue)
            entity.Stock = dto.Stock.Value;
        if (!string.IsNullOrEmpty(dto.Status))
            entity.Status = dto.Status;

        entity.UpdateTime = DateTime.Now;

        return await UpdateAsync(entity) > 0;
    }

    /// <summary>
    /// 批量更新SKU
    /// </summary>
    /// <param name="dto">批量更新参数</param>
    /// <returns>更新成功返回 true</returns>
    public async Task<bool> BatchUpdateAsync(BatchUpdateSkuDto dto)
    {
        var entities = await GetListAsync(s => dto.Ids.Contains(s.Id) && !s.IsDeleted);
        if (entities.Count == 0)
            return false;

        // 批量更新
        foreach (var entity in entities)
        {
            if (dto.RetailPrice.HasValue)
                entity.RetailPrice = dto.RetailPrice.Value;
            if (dto.MemberPrice.HasValue)
                entity.MemberPrice = dto.MemberPrice.Value;
            if (!string.IsNullOrEmpty(dto.Status))
                entity.Status = dto.Status;
            entity.UpdateTime = DateTime.Now;
        }

        return await _db.Updateable(entities).ExecuteCommandAsync() > 0;
    }

    /// <summary>
    /// 扣减库存
    /// </summary>
    /// <param name="skuId">SKU ID</param>
    /// <param name="quantity">扣减数量</param>
    /// <returns>扣减成功返回 true</returns>
    /// <exception cref="BusinessException">库存不足时抛出</exception>
    /// <remarks>
    /// 使用事务确保库存扣减的原子性
    /// </remarks>
    public async Task<bool> DeductStockAsync(Guid skuId, int quantity)
    {
        if (quantity <= 0)
            throw new BusinessException("扣减数量必须大于0", 400);

        return await ExecuteTransactionAsync(async () =>
        {
            // 锁定行进行查询
            var entity = await _db.Queryable<product_sku>()
                .With(SqlWith.RowLock)
                .FirstAsync(s => s.Id == skuId && !s.IsDeleted);

            if (entity == null)
                throw new BusinessException("SKU不存在", 404);

            if (entity.Stock < quantity)
                throw new BusinessException($"库存不足，当前库存：{entity.Stock}", 400);

            entity.Stock -= quantity;
            entity.UpdateTime = DateTime.Now;

            await _db.Updateable(entity).ExecuteCommandAsync();

            // TODO: 记录库存流水（待实现）
        });
    }

    /// <summary>
    /// 增加库存
    /// </summary>
    /// <param name="skuId">SKU ID</param>
    /// <param name="quantity">增加数量</param>
    /// <returns>增加成功返回 true</returns>
    public async Task<bool> AddStockAsync(Guid skuId, int quantity)
    {
        if (quantity <= 0)
            throw new BusinessException("增加数量必须大于0", 400);

        return await ExecuteTransactionAsync(async () =>
        {
            var entity = await GetByIdAsync(skuId);
            if (entity == null || entity.IsDeleted)
                throw new BusinessException("SKU不存在", 404);

            entity.Stock += quantity;
            entity.UpdateTime = DateTime.Now;

            await UpdateAsync(entity);

            // TODO: 记录库存流水（待实现）
        });
    }
}
```

