### 4.2 SPU 相关 DTO

```csharp
using System.ComponentModel.DataAnnotations;

namespace EasyProduct.Models.Dto.Product;

/// <summary>
/// 商品SPU DTO
/// </summary>
public class SpuDto
{
    /// <summary>
    /// SPU ID
    /// </summary>
    public Guid Id { get; set; }

    /// <summary>
    /// 商品编码
    /// </summary>
    public string Code { get; set; } = string.Empty;

    /// <summary>
    /// 商品名称
    /// </summary>
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// 英文名称
    /// </summary>
    public string? NameEn { get; set; }

    /// <summary>
    /// 分类ID
    /// </summary>
    public Guid CategoryId { get; set; }

    /// <summary>
    /// 商品类型
    /// </summary>
    /// <remarks>
    /// 使用 ProductType 常量：ProductType.Ticket（1）、ProductType.Normal（2）、ProductType.Service（3）
    /// </remarks>
    public int Type { get; set; } = ProductType.Normal;

    /// <summary>
    /// 主图URL
    /// </summary>
    public string MainImage { get; set; } = string.Empty;

    /// <summary>
    /// 商品图片列表
    /// </summary>
    public List<string>? Images { get; set; }

    /// <summary>
    /// 商品描述
    /// </summary>
    public string? Description { get; set; }

    /// <summary>
    /// 单位
    /// </summary>
    public string Unit { get; set; } = string.Empty;

    /// <summary>
    /// 品牌
    /// </summary>
    public string? Brand { get; set; }

    /// <summary>
    /// 规格组
    /// </summary>
    public List<SpecGroupDto>? Specs { get; set; }

    /// <summary>
    /// 状态
    /// </summary>
    /// <remarks>
    /// 使用 ProductSpuStatus 常量：ProductSpuStatus.Active（1）、ProductSpuStatus.Inactive（0）
    /// </remarks>
    public int Status { get; set; } = ProductSpuStatus.Inactive;

    /// <summary>
    /// SKU列表
    /// </summary>
    public List<SkuDto>? Skus { get; set; }

    /// <summary>
    /// 创建时间
    /// </summary>
    public DateTime CreatedAt { get; set; }
}

/// <summary>
/// 规格组 DTO
/// </summary>
public class SpecGroupDto
{
    /// <summary>
    /// 规格名称
    /// </summary>
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// 规格值列表
    /// </summary>
    public List<string> Values { get; set; } = new();
}

/// <summary>
/// 创建商品SPU DTO
/// </summary>
public class CreateSpuDto
{
    /// <summary>
    /// 商品编码
    /// </summary>
    [Required(ErrorMessage = "商品编码不能为空")]
    [MaxLength(50, ErrorMessage = "商品编码长度不能超过50")]
    public string Code { get; set; } = string.Empty;

    /// <summary>
    /// 商品名称
    /// </summary>
    [Required(ErrorMessage = "商品名称不能为空")]
    [MaxLength(200, ErrorMessage = "商品名称长度不能超过200")]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// 英文名称
    /// </summary>
    [MaxLength(200)]
    public string? NameEn { get; set; }

    /// <summary>
    /// 分类ID
    /// </summary>
    [Required(ErrorMessage = "分类ID不能为空")]
    public Guid CategoryId { get; set; }

    /// <summary>
    /// 商品类型
    /// </summary>
    /// <remarks>
    /// 使用 ProductType 常量：ProductType.Ticket（1）、ProductType.Normal（2）、ProductType.Service（3）
    /// </remarks>
    public int Type { get; set; } = ProductType.Normal;

    /// <summary>
    /// 主图URL
    /// </summary>
    [Required(ErrorMessage = "主图URL不能为空")]
    [MaxLength(500)]
    public string MainImage { get; set; } = string.Empty;

    /// <summary>
    /// 商品图片列表
    /// </summary>
    public List<string>? Images { get; set; }

    /// <summary>
    /// 商品描述
    /// </summary>
    public string? Description { get; set; }

    /// <summary>
    /// 单位
    /// </summary>
    [MaxLength(20)]
    public string Unit { get; set; } = "件";

    /// <summary>
    /// 品牌
    /// </summary>
    [MaxLength(100)]
    public string? Brand { get; set; }

    /// <summary>
    /// 规格组（用于自动生成SKU）
    /// </summary>
    public List<SpecGroupDto>? Specs { get; set; }

    /// <summary>
    /// 初始SKU列表（如果Specs为空，则使用此列表）
    /// </summary>
    public List<CreateSkuDto>? Skus { get; set; }
}

/// <summary>
/// 更新商品SPU DTO
/// </summary>
public class UpdateSpuDto
{
    /// <summary>
    /// SPU ID
    /// </summary>
    public Guid Id { get; set; }

    /// <summary>
    /// 商品名称
    /// </summary>
    [MaxLength(200)]
    public string? Name { get; set; }

    /// <summary>
    /// 英文名称
    /// </summary>
    [MaxLength(200)]
    public string? NameEn { get; set; }

    /// <summary>
    /// 分类ID
    /// </summary>
    public Guid? CategoryId { get; set; }

    /// <summary>
    /// 主图URL
    /// </summary>
    [MaxLength(500)]
    public string? MainImage { get; set; }

    /// <summary>
    /// 商品图片列表
    /// </summary>
    public List<string>? Images { get; set; }

    /// <summary>
    /// 商品描述
    /// </summary>
    public string? Description { get; set; }

    /// <summary>
    /// 单位
    /// </summary>
    [MaxLength(20)]
    public string? Unit { get; set; }

    /// <summary>
    /// 品牌
    /// </summary>
    [MaxLength(100)]
    public string? Brand { get; set; }

    /// <summary>
    /// 状态
    /// </summary>
    /// <remarks>
    /// 使用 ProductSpuStatus 常量：ProductSpuStatus.Active（1）、ProductSpuStatus.Inactive（0）
    /// </remarks>
    public int? Status { get; set; }
}

/// <summary>
/// 商品SPU查询 DTO
/// </summary>
public class SpuQueryDto
{
    /// <summary>
    /// 页码，从 1 开始
    /// </summary>
    [Range(1, int.MaxValue, ErrorMessage = "页码必须大于0")]
    public int PageIndex { get; set; } = 1;

    /// <summary>
    /// 每页数量
    /// </summary>
    [Range(1, 200, ErrorMessage = "每页数量必须在1-200之间")]
    public int PageSize { get; set; } = 10;

    /// <summary>
    /// 关键词（商品名称、编码）
    /// </summary>
    public string? Keyword { get; set; }

    /// <summary>
    /// 分类ID
    /// </summary>
    public Guid? CategoryId { get; set; }

    /// <summary>
    /// 商品类型
    /// </summary>
    public int? Type { get; set; }

    /// <summary>
    /// 状态
    /// </summary>
    public int? Status { get; set; }
}
