## 3. 实体类设计

### 3.1 ProductCategory - 商品分类

```csharp
using SqlSugar;
using EasyProduct.Models.Entitys.Base;
using EasyProduct.Models.Constants;

namespace EasyProduct.Models.Entitys.Product;

/// <summary>
/// 商品分类实体
/// </summary>
/// <remarks>
/// 树形结构，支持多级分类。表名：product_category
/// </remarks>
[SugarTable("product_category", "商品分类表")]
public class product_category : BaseEntity
{
    /// <summary>
    /// 分类名称
    /// </summary>
    [SugarColumn(Length = 100, ColumnDescription = "分类名称")]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// 英文名称
    /// </summary>
    [SugarColumn(Length = 100, IsNullable = true, ColumnDescription = "英文名称")]
    public string? NameEn { get; set; }

    /// <summary>
    /// 父分类ID（根分类为 null）
    /// </summary>
    [SugarColumn(IsNullable = true, ColumnDescription = "父分类ID")]
    public Guid? ParentId { get; set; }

    /// <summary>
    /// 分类编码（唯一）
    /// </summary>
    [SugarColumn(Length = 50, ColumnDescription = "分类编码")]
    public string Code { get; set; } = string.Empty;

    /// <summary>
    /// 排序序号
    /// </summary>
    [SugarColumn(ColumnDescription = "排序序号")]
    public int Sort { get; set; } = 0;
}
```

**说明：**
- 继承 `BaseEntity`，自动包含 `Id`、`IsDeleted`、`Status`、`CreatedAt`、`UpdatedAt`、`CreatedBy`、`UpdatedBy` 字段
- `IsDeleted` 使用 `DeleteStatus` 常量：`DeleteStatus.NotDeleted`（0）、`DeleteStatus.Deleted`（1）
- `Status` 使用 `CommonStatus` 常量：`CommonStatus.Enabled`（1）、`CommonStatus.Disabled`（0）
```

### 3.2 ProductSpu - 商品SPU

```csharp
using SqlSugar;
using EasyProduct.Models.Entitys.Base;
using EasyProduct.Models.Constants;

namespace EasyProduct.Models.Entitys.Product;

/// <summary>
/// 商品SPU实体
/// </summary>
/// <remarks>
/// 标准产品单元，关联多个SKU。表名：product_spu
/// </remarks>
[SugarTable("product_spu", "商品SPU表")]
public class product_spu : BaseEntity
{
    /// <summary>
    /// 商品编码（唯一）
    /// </summary>
    [SugarColumn(Length = 50, ColumnDescription = "商品编码")]
    public string Code { get; set; } = string.Empty;

    /// <summary>
    /// 商品名称
    /// </summary>
    [SugarColumn(Length = 200, ColumnDescription = "商品名称")]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// 英文名称
    /// </summary>
    [SugarColumn(Length = 200, IsNullable = true, ColumnDescription = "英文名称")]
    public string? NameEn { get; set; }

    /// <summary>
    /// 分类ID
    /// </summary>
    [SugarColumn(ColumnDescription = "分类ID")]
    public Guid CategoryId { get; set; }

    /// <summary>
    /// 商品类型：1-票务，2-普通商品，3-服务
    /// </summary>
    /// <remarks>
    /// 使用 ProductType 常量：ProductType.Ticket、ProductType.Normal、ProductType.Service
    /// </remarks>
    [SugarColumn(ColumnDescription = "商品类型")]
    public int Type { get; set; } = ProductType.Normal;

    /// <summary>
    /// 主图URL
    /// </summary>
    [SugarColumn(Length = 500, ColumnDescription = "主图URL")]
    public string MainImage { get; set; } = string.Empty;

    /// <summary>
    /// 商品图片（JSON数组）
    /// </summary>
    /// <example>
    /// ["http://example.com/1.jpg", "http://example.com/2.jpg"]
    /// </example>
    [SugarColumn(ColumnDataType = "text", IsNullable = true, ColumnDescription = "商品图片JSON数组")]
    public string? Images { get; set; }

    /// <summary>
    /// 商品描述
    /// </summary>
    [SugarColumn(ColumnDataType = "text", IsNullable = true, ColumnDescription = "商品描述")]
    public string? Description { get; set; }

    /// <summary>
    /// 单位
    /// </summary>
    [SugarColumn(Length = 20, ColumnDescription = "单位")]
    public string Unit { get; set; } = "件";

    /// <summary>
    /// 品牌
    /// </summary>
    [SugarColumn(Length = 100, IsNullable = true, ColumnDescription = "品牌")]
    public string? Brand { get; set; }

    /// <summary>
    /// 规格组（JSON数组）
    /// </summary>
    /// <example>
    /// [{"name":"颜色","values":["红色","蓝色"]},{"name":"尺寸","values":["S","M","L"]}]
    /// </example>
    [SugarColumn(ColumnDataType = "text", IsNullable = true, ColumnDescription = "规格组JSON数组")]
    public string? Specs { get; set; }
}
```

**说明：**
- 继承 `BaseEntity`，自动包含 `Id`、`IsDeleted`、`Status`、`CreatedAt`、`UpdatedAt`、`CreatedBy`、`UpdatedBy` 字段
- `Type` 使用 `ProductType` 常量：`ProductType.Ticket`（1）、`ProductType.Normal`（2）、`ProductType.Service`（3）
- `Status` 使用 `ProductSpuStatus` 常量：`ProductSpuStatus.Active`（1）、`ProductSpuStatus.Inactive`（0）
```

### 3.3 ProductSku - 商品SKU

```csharp
using SqlSugar;
using EasyProduct.Models.Entitys.Base;
using EasyProduct.Models.Constants;

namespace EasyProduct.Models.Entitys.Product;

/// <summary>
/// 商品SKU实体
/// </summary>
/// <remarks>
/// 库存单元，关联SPU。表名：product_sku
/// </remarks>
[SugarTable("product_sku", "商品SKU表")]
public class product_sku : BaseEntity
{
    /// <summary>
    /// SPU ID
    /// </summary>
    [SugarColumn(ColumnDescription = "SPU ID")]
    public Guid SpuId { get; set; }

    /// <summary>
    /// 规格值JSON对象
    /// </summary>
    /// <example>
    /// {"颜色":"红色","尺寸":"M"}
    /// </example>
    [SugarColumn(ColumnDataType = "text", IsNullable = true, ColumnDescription = "规格值JSON对象")]
    public string? SpecValues { get; set; }

    /// <summary>
    /// 条形码
    /// </summary>
    [SugarColumn(Length = 50, IsNullable = true, ColumnDescription = "条形码")]
    public string? Barcode { get; set; }

    /// <summary>
    /// 零售价
    /// </summary>
    [SugarColumn(Length = 18, DecimalDigits = 2, ColumnDescription = "零售价")]
    public decimal RetailPrice { get; set; }

    /// <summary>
    /// 会员价
    /// </summary>
    [SugarColumn(Length = 18, DecimalDigits = 2, ColumnDescription = "会员价")]
    public decimal MemberPrice { get; set; }

    /// <summary>
    /// B2B价
    /// </summary>
    [SugarColumn(Length = 18, DecimalDigits = 2, IsNullable = true, ColumnDescription = "B2B价")]
    public decimal? B2bPrice { get; set; }

    /// <summary>
    /// 成本价
    /// </summary>
    [SugarColumn(Length = 18, DecimalDigits = 2, ColumnDescription = "成本价")]
    public decimal CostPrice { get; set; }

    /// <summary>
    /// 库存数量
    /// </summary>
    [SugarColumn(ColumnDescription = "库存数量")]
    public int Stock { get; set; } = 0;
}
```

**说明：**
- 继承 `BaseEntity`，自动包含 `Id`、`IsDeleted`、`Status`、`CreatedAt`、`UpdatedAt`、`CreatedBy`、`UpdatedBy` 字段
- `Status` 使用 `ProductSkuStatus` 常量：`ProductSkuStatus.Active`（1）、`ProductSkuStatus.Inactive`（0）
```

### 3.4 ProductChannel - 商品渠道

```csharp
using SqlSugar;
using EasyProduct.Models.Entitys.Base;
using EasyProduct.Models.Constants;

namespace EasyProduct.Models.Entitys.Product;

/// <summary>
/// 商品渠道实体
/// </summary>
/// <remarks>
/// 销售渠道管理。表名：product_channel
/// </remarks>
[SugarTable("product_channel", "商品渠道表")]
public class product_channel : BaseEntity
{
    /// <summary>
    /// 渠道名称
    /// </summary>
    [SugarColumn(Length = 100, ColumnDescription = "渠道名称")]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// 渠道编码（唯一）
    /// </summary>
    [SugarColumn(Length = 50, ColumnDescription = "渠道编码")]
    public string Code { get; set; } = string.Empty;

    /// <summary>
    /// 渠道类型：1-线上，2-线下，3-第三方
    /// </summary>
    /// <remarks>
    /// 使用 ProductChannelType 常量：
    /// - ProductChannelType.Online（1）- 线上
    /// - ProductChannelType.Offline（2）- 线下
    /// - ProductChannelType.ThirdParty（3）- 第三方
    /// </remarks>
    [SugarColumn(ColumnDescription = "渠道类型")]
    public int Type { get; set; } = ProductChannelType.Online;

    /// <summary>
    /// 渠道描述
    /// </summary>
    [SugarColumn(ColumnDataType = "text", IsNullable = true, ColumnDescription = "渠道描述")]
    public string? Description { get; set; }
}
```

**说明：**
- 继承 `BaseEntity`，自动包含 `Id`、`IsDeleted`、`Status`、`CreatedAt`、`UpdatedAt`、`CreatedBy`、`UpdatedBy` 字段
- `Status` 使用 `CommonStatus` 常量：`CommonStatus.Enabled`（1）、`CommonStatus.Disabled`（0）
- `Type` 使用 `ProductChannelType` 常量：`ProductChannelType.Online`（1）、`ProductChannelType.Offline`（2）、`ProductChannelType.ThirdParty`（3）
```

