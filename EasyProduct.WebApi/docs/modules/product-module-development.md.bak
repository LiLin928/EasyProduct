## 7. 数据库表设计（SQL）

### 7.1 商品分类表

```sql
-- 商品分类表
CREATE TABLE `product_category` (
  `id` char(36) NOT NULL COMMENT '分类ID',
  `name` varchar(100) NOT NULL COMMENT '分类名称',
  `name_en` varchar(100) DEFAULT NULL COMMENT '英文名称',
  `parent_id` char(36) DEFAULT NULL COMMENT '父分类ID',
  `code` varchar(50) NOT NULL COMMENT '分类编码',
  `sort` int NOT NULL DEFAULT '0' COMMENT '排序序号',
  `status` varchar(20) NOT NULL DEFAULT 'enabled' COMMENT '状态：enabled-启用，disabled-禁用',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否删除',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  `create_by` varchar(50) DEFAULT NULL COMMENT '创建人',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_code` (`code`),
  KEY `idx_parent_id` (`parent_id`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='商品分类表';

-- 初始化分类数据
INSERT INTO `product_category` (`id`, `name`, `name_en`, `parent_id`, `code`, `sort`, `status`, `create_by`)
VALUES
('分类ID', '票务', 'Ticket', NULL, 'ticket', 1, 'enabled', 'system'),
('分类ID', '特产', 'Specialty', NULL, 'specialty', 2, 'enabled', 'system'),
('分类ID', '服务', 'Service', NULL, 'service', 3, 'enabled', 'system');
```

### 7.2 商品SPU表

```sql
-- 商品SPU表
CREATE TABLE `product_spu` (
  `id` char(36) NOT NULL COMMENT 'SPU ID',
  `code` varchar(50) NOT NULL COMMENT '商品编码',
  `name` varchar(200) NOT NULL COMMENT '商品名称',
  `name_en` varchar(200) DEFAULT NULL COMMENT '英文名称',
  `category_id` char(36) NOT NULL COMMENT '分类ID',
  `type` varchar(20) NOT NULL DEFAULT 'normal' COMMENT '商品类型：ticket-票务，normal-普通商品，service-服务',
  `main_image` varchar(500) NOT NULL COMMENT '主图URL',
  `images` text COMMENT '商品图片JSON数组',
  `description` text COMMENT '商品描述',
  `unit` varchar(20) NOT NULL DEFAULT '件' COMMENT '单位',
  `brand` varchar(100) DEFAULT NULL COMMENT '品牌',
  `specs` text COMMENT '规格组JSON数组',
  `status` varchar(20) NOT NULL DEFAULT 'inactive' COMMENT '状态：active-上架，inactive-下架',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否删除',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  `create_by` varchar(50) DEFAULT NULL COMMENT '创建人',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_code` (`code`),
  KEY `idx_category_id` (`category_id`),
  KEY `idx_type` (`type`),
  KEY `idx_status` (`status`),
  KEY `idx_create_time` (`create_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='商品SPU表';
```

### 7.3 商品SKU表

```sql
-- 商品SKU表
CREATE TABLE `product_sku` (
  `id` char(36) NOT NULL COMMENT 'SKU ID',
  `spu_id` char(36) NOT NULL COMMENT 'SPU ID',
  `spec_values` text COMMENT '规格值JSON对象',
  `barcode` varchar(50) DEFAULT NULL COMMENT '条形码',
  `retail_price` decimal(18,2) NOT NULL COMMENT '零售价',
  `member_price` decimal(18,2) NOT NULL COMMENT '会员价',
  `b2b_price` decimal(18,2) DEFAULT NULL COMMENT 'B2B价',
  `cost_price` decimal(18,2) NOT NULL COMMENT '成本价',
  `stock` int NOT NULL DEFAULT '0' COMMENT '库存数量',
  `status` varchar(20) NOT NULL DEFAULT 'active' COMMENT '状态：active-上架，inactive-下架',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否删除',
  `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  `create_by` varchar(50) DEFAULT NULL COMMENT '创建人',
  PRIMARY KEY (`id`),
  KEY `idx_spu_id` (`spu_id`),
  KEY `idx_barcode` (`barcode`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='商品SKU表';
```

